{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2020",
    "moduleResolution": "Node",
    "lib": [
      "ES2021"
    ],
    "outDir": "lib",
    "rootDir": ".",
    "baseUrl": "src",
    "paths": {
      "@lib/minecraft": [
        "@library/minecraft/Minecraft.ts"
      ],
      "@zpk": [
        "zpk.ts"
      ],
      "@oj-realm": [
        "OJ Realm/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "lib",
    "dist",
    "node_modules"
  ],
  "compileOnSave": true
}